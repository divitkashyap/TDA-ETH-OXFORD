{
  "buildCommand": "cd frontend/twitter-debate-analyzer && npm run build",
  "outputDirectory": "frontend/twitter-debate-analyzer/dist",
  "installCommand": "cd frontend/twitter-debate-analyzer && npm install",
  "devCommand": "cd frontend/twitter-debate-analyzer && npm run dev",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
